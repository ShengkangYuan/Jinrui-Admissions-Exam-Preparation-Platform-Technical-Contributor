<Slide style={{
  width: '1280px',
  height: '720px',
  background: '#0A0F1E',
  padding: '40px 64px',
  flexDirection: 'column',
}}>
  <Text style={{
    fontSize: 34,
    fontWeight: 'bold',
    color: '#F8FAFC',
    marginBottom: 20,
    fontFamily: '"PingFang SC","Microsoft YaHei",sans-serif',
  }}>
    我的作业 · 24 小时紧急区 + 整卡开卷
  </Text>
  <Box style={{
    flex: 1,
    background: '#131C33',
    borderRadius: 20,
    padding: 10,
    border: '1px solid rgba(37,99,235,0.2)',
    marginBottom: 20,
  }}>
    <Image
      src="assets/01_space_assignments.png"
      style={{ width: '100%', height: '100%', objectFit: 'contain', borderRadius: 12 }}
    />
  </Box>
  <Box style={{
    flexDirection: 'row',
    gap: 20,
  }}>
    {[
      { icon: 'clock', title: 'DDL 由近到远', desc: '默认按截止时间升序排列' },
      { icon: 'exclamation-circle', title: '24h 紧急区', desc: '独立红色区域 + 实时倒计时' },
      { icon: 'arrow-right', title: '整卡开卷', desc: '点击卡片任意处即可继续作答' },
    ].map((c, i) => (
      <Box key={i} style={{
        flex: 1,
        background: '#131C33',
        borderRadius: 14,
        padding: 18,
        flexDirection: 'row',
        alignItems: 'center',
        gap: 14,
        borderLeft: '3px solid #D4AF37',
      }}>
        <FAIcon name={c.icon} style={{ fill: '#D4AF37', width: 28, height: 28 }} />
        <Box>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F8FAFC' }}>{c.title}</Text>
          <Text style={{ fontSize: 15, color: '#7A89A3', marginTop: 4 }}>{c.desc}</Text>
        </Box>
      </Box>
    ))}
  </Box>
  <Box style={{
    flexDirection: 'row',
    justifyContent: 'space-between',
    marginTop: 20,
  }}>
    <Text style={{ fontSize: 14, color: '#7A89A3' }}>金瑞升学 · 金鹰系统</Text>
    <Text style={{ fontSize: 14, color: '#7A89A3' }}>06 / 18</Text>
  </Box>
</Slide>
