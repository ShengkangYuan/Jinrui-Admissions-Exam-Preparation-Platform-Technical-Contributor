# ===== 必选(本地开发保持默认即可)=====

# SQLite 数据库文件位置(相对 prisma/schema.prisma 所在目录,即 apps/api/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# JWT 签名密钥:本地开发可随意填写;正式部署务必改成随机长字符串
JWT_SECRET="dev-secret-change-me"

# 后端监听端口
PORT=4000

# ===== 可选:AI 能力(留空可正常运行,仅 AI 相关功能不可用)=====

# 文本大模型(OpenAI 兼容接口):用于学生端「AI 解析」、教师端「一键修正题目」等
# 例如 DeepSeek:LLM_BASE_URL=https://api.deepseek.com/v1,LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉大模型(OpenAI 兼容接口):仅用于教师端 PDF / 图片批量识别录题
# 例如阿里云通义千问:VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# ===== 可选:高级配置 =====

# 上传文件目录(图片/音频)。本地开发默认 apps/web/public/uploads,无需设置;
# Linux 生产环境由 Nginx 托管时可设为 /var/www/uploads
# UPLOAD_DIR=

# PDF 录题栅格化所用的 Python 解释器(默认依次尝试 python3、python)
# PYTHON_BIN=python
